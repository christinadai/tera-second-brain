# Copy to .env and fill in. .env is gitignored and must never be committed.
# Register a "script" type app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit asks for a descriptive user agent naming the app and contact.
REDDIT_USER_AGENT=tera-second-brain/0.1 by u/YOUR_REDDIT_USERNAME
